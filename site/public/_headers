# Static assets are served by Cloudflare's asset store without invoking the Worker, so the
# protective headers the Worker sets on rendered responses have to be declared for them here too.
# The CSP is deliberately stricter than the Worker's: nothing in this directory is a document
# that needs to run scripts or submit forms. Every page is rendered by the Worker.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Cache content-hashed assets immutably (generated by vinext)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
